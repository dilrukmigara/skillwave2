# Canonical public origin. Set the real custom domain when it is connected.
NEXT_PUBLIC_SITE_URL=https://skillwave2.vercel.app

# Supabase project settings (publishable key only; never a service/secret key).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Exact app origin used in confirmation and recovery emails.
AUTH_SITE_URL=http://127.0.0.1:3000

# Server-only secret key for Superadmin staff creation. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
